{
  "buildCommand": "cd ui && npm install && npm run build",
  "outputDirectory": "ui/dist",
  "framework": null,
  "installCommand": "echo 'skip root install'",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self)" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://voice-function.onrender.com/v1/:path*" },
    { "source": "/health", "destination": "https://voice-function.onrender.com/health" }
  ]
}