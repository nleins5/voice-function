{
  "version": 2,
  "builds": [
    { "src": "ui/package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self)" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "https://free-ai-gateway.onrender.com/v1/$1",
      "headers": {
        "X-Gateway-Key": "$GATEWAY_SECRET"
      }
    },
    {
      "src": "/health",
      "dest": "https://free-ai-gateway.onrender.com/health"
    },
    {
      "src": "/docs",
      "dest": "https://free-ai-gateway.onrender.com/docs"
    },
    {
      "src": "/openapi.json",
      "dest": "https://free-ai-gateway.onrender.com/openapi.json"
    },
    { "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?|ttf|eot))$", "dest": "/ui/$1" },
    { "src": "/assets/(.*)", "dest": "/ui/assets/$1" },
    { "src": "/(.*)", "dest": "/ui/index.html" }
  ]
}