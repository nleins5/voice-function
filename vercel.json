{
  "buildCommand": "cd ui && npm install && npm run build",
  "outputDirectory": "ui/dist",
  "framework": null,
  "installCommand": "cd ui && npm install",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Permissions-Policy", "value": "microphone=(self)" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/v1/:path*", "destination": "https://free-ai-gateway.onrender.com/v1/:path*" },
    { "source": "/health", "destination": "https://free-ai-gateway.onrender.com/health" },
    { "source": "/docs", "destination": "https://free-ai-gateway.onrender.com/docs" },
    { "source": "/openapi.json", "destination": "https://free-ai-gateway.onrender.com/openapi.json" }
  ]
}